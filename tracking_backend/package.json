    "db:seed": "ts-node src/seed.ts",
    "db:seed:prod": "ts-node src/seed.prod.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "prisma": "^5.16.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
