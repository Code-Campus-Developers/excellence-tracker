    "db:seed": "ts-node src/seed.ts",
    "db:seed:prod": "ts-node src/seed.prod.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "resend": "^6.17.2",
    "xlsx": "^0.18.5"
